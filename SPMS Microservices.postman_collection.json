          "name": "1.1 Register DRIVER",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const data = pm.response.json().data;",
                  "    pm.collectionVariables.set('driver_token', data.accessToken);",
                  "    pm.collectionVariables.set('driver_id', data.id);",
                  "    console.log('driver_id set to: ' + data.id);",
                  "} else {",
                  "    console.log('Register DRIVER did not return 201 - check response before continuing');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Driver Test\",\n  \"email\": \"driver_{{$timestamp}}@spms.com\",\n  \"password\": \"test1234\",\n  \"role\": \"DRIVER\"\n}"
